EMBED %ProcedureRoutines
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
Agregar ROUTINE
  RQ:Linea = L:Txt
  ADD(ResQ)

MostrarError ROUTINE
  L:Txt = 'ERROR: ' & SQL.ErrorText()
  DO Agregar

! modo automatico (TCWMsSQLDemo.exe ejemplos): agrega lo que muestra la lista a ejemplos.txt
Volcar ROUTINE
  SQL.LogFile = LONGPATH() & '\ejemplos.txt'
  SQL.WriteLog('== ' & CLIP(L:Titulo))
  LOOP L:I = 1 TO RECORDS(ResQ)
    GET(ResQ,L:I)
    SQL.WriteLog('   ' & CLIP(RQ:Linea))
  END
  SQL.LogFile = ''

! 1. parametros '?'
Param ROUTINE
  FREE(ResQ)
  L:T0 = CLOCK()
  SQL.AddParam(L:Cliente)
  SQL.AddParam(FORMAT(L:Desde,@d10-))
  IF SQL.ExecEx('SELECT TOP 200 IdTransaccion, Fecha, TipoCbte, NroCbte, Descripcion, ImporteTotal' & |
                ' FROM cbtes WHERE IdCliente = ? AND Fecha >= ? ORDER BY Fecha DESC, IdTransaccion DESC',1)
    DO MostrarError
    EXIT
  END
  L:N = 0
  LOOP UNTIL SQL.Next()
    L:N += 1
    L:Txt = FORMAT(SQL.Col(1),@n_10) & '  ' & SQL.Col(2) & '  ' & FORMAT(SQL.Col(3),@s4) & FORMAT(SQL.Col(4),@n_9) & '  ' & |
            FORMAT(SQL.ColByName('Descripcion'),@s45) & FORMAT(SQL.Col(6),@n-16.2)
    DO Agregar
  END
  RQ:Linea = L:N & ' comprobantes del cliente ' & L:Cliente & ' desde el ' & FORMAT(L:Desde,@d6) & ' en ' & (CLOCK() - L:T0) * 10 & |
             ' ms (dos parametros ?, sin comillas)'
  ADD(ResQ,1)

! 2. INSERT por nombre de campo
Insert ROUTINE
  FREE(ResQ)
  SQL.Campo('Nombre',L:Nombre)
  SQL.Campo('Importe',L:Importe)
  SQL.CampoFecha('Fecha',L:Fecha)
  SQL.CampoFechaHora('Hora',TODAY(),CLOCK())
  SQL.CampoNulo('Nota')
  IF SQL.Insertar('tempdb.dbo.tcw_demo')
    DO MostrarError
    EXIT
  END
  L:Txt = 'Insertado. Ultimas filas de tempdb.dbo.tcw_demo (Id, Nombre, Importe, Fecha, Hora, Nota):'
  DO Agregar
  DO MostrarDemo

MostrarDemo ROUTINE
  IF SQL.ExecEx('SELECT TOP 15 Id, Nombre, Importe, Fecha, CONVERT(varchar(19), Hora, 120), ' & |
                'CASE WHEN Nota IS NULL THEN ''(NULL)'' ELSE CAST(LEN(Nota) AS varchar(10)) + '' caracteres'' END' & |
                ' FROM tempdb.dbo.tcw_demo ORDER BY Id DESC',1)
    DO MostrarError
    EXIT
  END
  LOOP UNTIL SQL.Next()
    L:Txt = FORMAT(SQL.Col(1),@n6) & '  ' & FORMAT(SQL.Col(2),@s36) & FORMAT(SQL.Col(3),@n-12.2) & '  ' & |
            FORMAT(SQL.Col(4),@s11) & FORMAT(SQL.Col(5),@s20) & SQL.Col(6)
    DO Agregar
  END

! 3. tres formas de grabar las mismas filas; la barra la mueve esta rutina (la de la clase se apaga para no
!    sumarle a la forma 1 el repintado de cada consulta)
Lote ROUTINE
  FREE(ResQ)
  IF L:Cantidad < 1 THEN L:Cantidad = 1000.
  L:Feq1 = SQL.ProgressFeq
  L:Feq2 = SQL.ProgressTextFeq
  SQL.ProgressFeq = 0
  SQL.ProgressTextFeq = 0
  L:Base = 0
  LOOP L:M = 1 TO 3
    SQL.ExecEx('TRUNCATE TABLE tempdb.dbo.tcw_demo_lote',1)
    L:T0 = CLOCK()
    LOOP L:I = 1 TO L:Cantidad
      IF L:M = 1
        IF SQL.ExecEx('INSERT INTO tempdb.dbo.tcw_demo_lote (Id, Nombre, Importe, Fecha) VALUES (' & L:I & ', ' & |
                      SQL.Quote('Cliente ' & L:I) & ', ' & L:I * 1.25 & ', ''' & FORMAT(TODAY() - L:I % 365,@d10-) & ''')',1)
          DO MostrarError
          BREAK
        END
      ELSE
        SQL.Campo('Id',L:I)
        SQL.Campo('Nombre','Cliente ' & L:I)
        SQL.Campo('Importe',L:I * 1.25)
        SQL.CampoFecha('Fecha',TODAY() - L:I % 365)
        IF L:M = 2
          IF SQL.Insertar('tempdb.dbo.tcw_demo_lote') THEN DO MostrarError ; BREAK.
        ELSE
          IF SQL.InsertarLote('tempdb.dbo.tcw_demo_lote') THEN DO MostrarError ; BREAK.
        END
      END
      IF L:I % 250 = 0
        ?SQLBarra{PROP:Progress} = L:I * 100 / L:Cantidad
        ?SQLTexto{PROP:Text} = CLIP(L:Metodo[L:M]) & ': ' & L:I & ' de ' & L:Cantidad & ' filas'
        DISPLAY(?SQLBarra)
        DISPLAY(?SQLTexto)
      END
    END
    IF L:M = 3 AND SQL.EnviarLote() THEN DO MostrarError.
    L:Ms = (CLOCK() - L:T0) * 10
    IF L:M = 1 THEN L:Base = L:Ms.
    L:Hay = SQL.Fetch(1,'SELECT COUNT(*) FROM tempdb.dbo.tcw_demo_lote')
    L:Txt = FORMAT(L:Metodo[L:M],@s44) & FORMAT(L:Ms,@n8) & ' ms' & FORMAT(CHOOSE(L:Ms > 0,L:Cantidad * 1000 / L:Ms,0),@n9) & ' filas/s' & |
            CHOOSE(L:M > 1 AND L:Ms > 0,'   ' & CLIP(LEFT(FORMAT(L:Base / L:Ms,@n6.1))) & ' veces mas rapido','') & |
            CHOOSE(L:Hay = L:Cantidad,'','   (grabo ' & L:Hay & ')')
    DO Agregar
    DISPLAY(?Res)
  END
  SQL.ProgressFeq = L:Feq1
  SQL.ProgressTextFeq = L:Feq2
  ?SQLBarra{PROP:Progress} = 100
  ?SQLTexto{PROP:Text} = 'Listo: ' & L:Cantidad & ' filas de cada forma en tempdb.dbo.tcw_demo_lote'
  DISPLAY()

! 4. sentencia preparada, dos veces con otros valores
Prepara ROUTINE
  FREE(ResQ)
  IF SQL.Fetch(1,'SELECT COUNT(*) FROM tempdb.dbo.tcw_demo_lote') = 0
    LOOP L:I = 1 TO 1000
      SQL.Campo('Id',L:I)
      SQL.Campo('Nombre','Cliente ' & L:I)
      SQL.Campo('Importe',L:I * 1.25)
      SQL.CampoFecha('Fecha',TODAY() - L:I % 365)
      SQL.InsertarLote('tempdb.dbo.tcw_demo_lote')
    END
    SQL.EnviarLote()
  END
  L:Txt = 'Antes:   ' & SQL.Fetch(1,'SELECT CAST(COUNT(*) AS varchar(10)) + '' filas, suma '' + CAST(SUM(Importe) AS varchar(30)) FROM tempdb.dbo.tcw_demo_lote')
  DO Agregar
  IF SQL.Prepare('UPDATE tempdb.dbo.tcw_demo_lote SET Importe = Importe * ? WHERE Id % ? = 0')
    DO MostrarError
    EXIT
  END
  SQL.AddParam('2')
  SQL.AddParam('10')
  IF SQL.ExecPrepared() THEN DO MostrarError ; EXIT.
  L:Txt = 'ExecPrepared con 2 y 10:   ' & SQL.AffectedRows() & ' filas (Importe x 2 donde Id es multiplo de 10)'
  DO Agregar
  L:Txt = '         ' & SQL.Fetch(1,'SELECT CAST(COUNT(*) AS varchar(10)) + '' filas, suma '' + CAST(SUM(Importe) AS varchar(30)) FROM tempdb.dbo.tcw_demo_lote')
  DO Agregar
  SQL.AddParam('0.5')
  SQL.AddParam('10')
  IF SQL.ExecPrepared() THEN DO MostrarError ; EXIT.
  L:Txt = 'ExecPrepared con 0.5 y 10: ' & SQL.AffectedRows() & ' filas (misma sentencia, otros valores: vuelve al importe original)'
  DO Agregar
  L:Txt = 'Despues: ' & SQL.Fetch(1,'SELECT CAST(COUNT(*) AS varchar(10)) + '' filas, suma '' + CAST(SUM(Importe) AS varchar(30)) FROM tempdb.dbo.tcw_demo_lote')
  DO Agregar

! 5. transaccion con rollback
Trans ROUTINE
  FREE(ResQ)
  L:Txt = 'Filas antes:                     ' & SQL.Fetch(1,'SELECT COUNT(*) FROM tempdb.dbo.tcw_demo_lote')
  DO Agregar
  IF SQL.BeginTransaction() THEN DO MostrarError ; EXIT.
  SQL.ExecEx('DELETE FROM tempdb.dbo.tcw_demo_lote',1)
  L:Txt = 'BeginTransaction + DELETE:       borradas ' & SQL.AffectedRows() & ', quedan ' & SQL.Fetch(1,'SELECT COUNT(*) FROM tempdb.dbo.tcw_demo_lote')
  DO Agregar
  IF SQL.Rollback() THEN DO MostrarError ; EXIT.
  L:Txt = 'Rollback:                        quedan ' & SQL.Fetch(1,'SELECT COUNT(*) FROM tempdb.dbo.tcw_demo_lote') & ' (no se borro nada)'
  DO Agregar

! 6. procedimiento con dos resultados
Varios ROUTINE
  FREE(ResQ)
  SQL.AddParam(L:Cliente2)
  IF SQL.ExecSP('EXEC #tcw_demo_sp ?')
    DO MostrarError
    EXIT
  END
  L:Txt = 'Resultado 1 (' & CLIP(SQL.Field(1)) & ', ' & CLIP(SQL.Field(2)) & ', ' & CLIP(SQL.Field(3)) & '): resumen por tipo del cliente ' & L:Cliente2
  DO Agregar
  LOOP UNTIL SQL.Next()
    L:Txt = '   ' & FORMAT(SQL.Col(1),@s5) & FORMAT(SQL.Col(2),@n8) & ' comprobantes' & FORMAT(SQL.Col(3),@n-20.2)
    DO Agregar
  END
  IF SQL.NextResult() = Level:Benign
    L:Txt = 'Resultado 2 (' & SQL.Columns() & ' columnas): los ultimos 10'
    DO Agregar
    LOOP UNTIL SQL.Next()
      L:Txt = '   ' & FORMAT(SQL.Col(1),@n_10) & '  ' & SQL.Col(2) & '  ' & FORMAT(SQL.Col(3),@s4) & FORMAT(SQL.Col(4),@n_9) & FORMAT(SQL.Col(5),@n-16.2)
      DO Agregar
    END
  END

! 7. varchar(max)
Largo ROUTINE
  FREE(ResQ)
  IF L:Largo < 1 THEN L:Largo = 20000.
  SQL.Campo('Nombre','Texto de ' & L:Largo & ' caracteres')
  SQL.Campo('Importe',0)
  SQL.Campo('Nota',ALL('0123456789',L:Largo))
  IF SQL.Insertar('tempdb.dbo.tcw_demo')
    DO MostrarError
    EXIT
  END
  IF SQL.ExecEx('SELECT TOP 1 LEN(Nota), Nota FROM tempdb.dbo.tcw_demo ORDER BY Id DESC',1) THEN DO MostrarError ; EXIT.
  SQL.Next()
  L:N = LEN(SQL.Col(2))
  L:Txt = 'Grabado: ' & SQL.Col(1) & ' caracteres en el servidor; leido: ' & L:N & CHOOSE(SQL.Col(2) = ALL('0123456789',L:Largo),' (identico)',' (DISTINTO)')
  DO Agregar
  DO MostrarDemo
[END]
[END]
[WINDOW]
Window WINDOW('Ejemplos de uso - SQLMsDirectClass (SQL Server directo)'),AT(,,640,406),CENTER,GRAY,SYSTEM,MAX,FONT('Segoe UI',9)
       SHEET,AT(4,4,632,174),USE(?Sheet)
           TAB('1. Parametros ?'),USE(?Tab1)
             PROMPT('Cliente:'),AT(12,24),USE(?L:Cliente:Prompt)
             ENTRY(@n_10),AT(42,22,50,12),USE(L:Cliente)
             PROMPT('Desde:'),AT(102,24),USE(?L:Desde:Prompt)
             ENTRY(@d6),AT(128,22,52,12),USE(L:Desde)
             BUTTON('&Buscar'),AT(564,20,64,16),USE(?Run1)
             TEXT,AT(10,42,618,130),USE(L:Cod1),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('2. Insertar'),USE(?Tab2)
             PROMPT('Nombre:'),AT(12,24),USE(?L:Nombre:Prompt)
             ENTRY(@s60),AT(42,22,200,12),USE(L:Nombre)
             PROMPT('Importe:'),AT(250,24),USE(?L:Importe:Prompt)
             ENTRY(@n-12.2),AT(282,22,60,12),USE(L:Importe)
             PROMPT('Fecha:'),AT(350,24),USE(?L:Fecha:Prompt)
             ENTRY(@d6),AT(376,22,52,12),USE(L:Fecha)
             BUTTON('&Insertar'),AT(564,20,64,16),USE(?Run2)
             TEXT,AT(10,42,618,130),USE(L:Cod2),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('3. InsertarLote'),USE(?Tab3)
             PROMPT('Filas:'),AT(12,24),USE(?L:Cantidad:Prompt)
             SPIN(@n7),AT(42,22,60,12),USE(L:Cantidad),RANGE(100,200000),STEP(1000)
             PROMPT('Graba las mismas filas de tres formas y compara los tiempos.'),AT(110,24),USE(?Lote:Nota)
             BUTTON('&Comparar'),AT(564,20,64,16),USE(?Run3)
             TEXT,AT(10,42,618,130),USE(L:Cod3),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('4. Prepare'),USE(?Tab4)
             PROMPT('Un UPDATE preparado, ejecutado dos veces con otros valores.'),AT(12,24),USE(?Prep:Nota)
             BUTTON('&Ejecutar'),AT(564,20,64,16),USE(?Run4)
             TEXT,AT(10,42,618,130),USE(L:Cod4),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('5. Transaccion'),USE(?Tab5)
             PROMPT('BeginTransaction, DELETE y Rollback: no se borra nada.'),AT(12,24),USE(?Trans:Nota)
             BUTTON('&Ejecutar'),AT(564,20,64,16),USE(?Run5)
             TEXT,AT(10,42,618,130),USE(L:Cod5),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('6. Varios resultados'),USE(?Tab6)
             PROMPT('Cliente:'),AT(12,24),USE(?L:Cliente2:Prompt)
             ENTRY(@n_10),AT(42,22,50,12),USE(L:Cliente2)
             BUTTON('&Ejecutar'),AT(564,20,64,16),USE(?Run6)
             TEXT,AT(10,42,618,130),USE(L:Cod6),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
           TAB('7. Texto largo'),USE(?Tab7)
             PROMPT('Caracteres:'),AT(12,24),USE(?L:Largo:Prompt)
             SPIN(@n7),AT(52,22,60,12),USE(L:Largo),RANGE(1,1000000),STEP(10000)
             BUTTON('&Ejecutar'),AT(564,20,64,16),USE(?Run7)
             TEXT,AT(10,42,618,130),USE(L:Cod7),SKIP,FONT('Consolas',8),VSCROLL,READONLY
           END
       END
       PROGRESS,AT(4,182,632,8),USE(?SQLBarra),RANGE(0,100)
       STRING(''),AT(4,192,632,10),USE(?SQLTexto),FONT(,,0808080H)
       LIST,AT(4,204,632,180),USE(?Res),VSCROLL,FROM(ResQ),FONT('Consolas',8),FORMAT('1000L(2)@s250@')
       BUTTON('&Cerrar'),AT(576,388,60,14),USE(?Close),STD(STD:Close)
     END
[END]
