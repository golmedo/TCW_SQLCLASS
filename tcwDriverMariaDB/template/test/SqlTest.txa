[APPLICATION]
VERSION 34
TODO ABC ToDo
PROCEDURE Main
[COMMON]
FROM ABC
MODIFIED '2026/10/28' '12:00:00'
[ADDITION]
NAME SqlClass SQLClass
[INSTANCE]
INSTANCE 1
[PROMPTS]
%QDriver DEFAULT  ('ODBC')
%QDriverFromAppOpt LONG  (0)
%QDriverLocal DEFAULT  ('ODBC')
%QTablaSQL DEFAULT  ('sqlclass')
%QMaxFields DEFAULT  ('25')
%QFieldSize DEFAULT  ('50')
%QMaxRegistros LONG  (0)
%QCantMaxRegistros DEFAULT  ('500')
%QTodosLosSQL MULTI LONG  (1, 2)
%QMiSQL DEPEND %QTodosLosSQL DEFAULT TIMES 2
WHEN  (1) ('SQL')
WHEN  (2) ('SQLM')
%QMiSQLMotor DEPEND %QTodosLosSQL DEFAULT TIMES 2
WHEN  (1) ('Driver de la app')
WHEN  (2) ('MariaDB directo')
%QMiSQLConexion DEPEND %QTodosLosSQL DEFAULT TIMES 2
WHEN  (1) ('')
WHEN  (2) ('GETINI(''Conexion'',''Cadena'','''',LONGPATH() & ''\SqlTest.ini'')')

[PROJECT]
#noedit
#system win32 exe
#model clarion dll
#compile "SqlTest.clw" -- GENERATED
#compile "SqlTest001.clw" -- GENERATED
#pragma define(StringTheoryLinkMode=>1)
#pragma define(StringTheoryDLLMode=>0)
#link "SqlTest.exe"
[PROGRAM]
NAME 'SqlTest.clw'
[COMMON]
FROM ABC ABC
MODIFIED '2026/10/28' '12:00:00'
[END]
[MODULE]
NAME 'SqlTest001.clw'
[COMMON]
FROM ABC GENERATED
MODIFIED '2026/10/28' '12:00:00'
[PROCEDURE]
NAME Main
[COMMON]
FROM ABC Source
MODIFIED '2026/10/28' '12:00:00'
[EMBED]
EMBED %DataSection
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
L:Conn               CSTRING(1024)
L:Q                  CSTRING(500)
[END]
EMBED %ProcessedCode
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
  ! Prueba del template: SQL = driver de la app (ODBC), SQLM = MariaDB directo. Mismo codigo para las dos.
  L:Conn = GETINI('Conexion','Cadena','',LONGPATH() & '\SqlTest.ini')
  SQLM.LogFile = LONGPATH() & '\resultado.txt'
  SQL.SilentMode = True
  SQLM.SilentMode = True
  IF SQL.Init(sqlclass,uSQL:Record,L:Conn)
    SQLM.WriteLog('SQL  Init ERROR')
  ELSE
    L:Q = 'SELECT COUNT(*) FROM cbtes WHERE Fecha >= ''2026-01-01'''
    IF SQL.ExecEx(L:Q,1) = 0 AND SQL.Next() = 0
      SQLM.WriteLog('SQL  cantidad 2026: ' & SQL.Col(1))
    ELSE
      SQLM.WriteLog('SQL  ERROR en la consulta')
    END
    L:Q = 'SELECT Descripcion FROM cbtes ORDER BY LENGTH(Descripcion) DESC LIMIT 1'
    IF SQL.ExecEx(L:Q,1) = 0 AND SQL.Next() = 0
      SQLM.WriteLog('SQL  razon social mas larga: ' & LEN(CLIP(SQL.Col(1))) & ' caracteres')
    END
    SQL.Kill()
  END
  IF SQLM.State <> SQL:Ready                    ! lo conecto el template global (Conexion del objeto)
    SQLM.WriteLog('SQLM Init ERROR: ' & SQLM.ErrorText())
  ELSE
    L:Q = 'SELECT COUNT(*) FROM cbtes WHERE Fecha >= ''2026-01-01'''
    IF SQLM.ExecEx(L:Q,1) = 0 AND SQLM.Next() = 0
      SQLM.WriteLog('SQLM cantidad 2026: ' & SQLM.Col(1))
    ELSE
      SQLM.WriteLog('SQLM ERROR en la consulta: ' & SQLM.ErrorText())
    END
    L:Q = 'SELECT Descripcion FROM cbtes ORDER BY LENGTH(Descripcion) DESC LIMIT 1'
    IF SQLM.ExecEx(L:Q,1) = 0 AND SQLM.Next() = 0
      SQLM.WriteLog('SQLM razon social mas larga: ' & LEN(CLIP(SQLM.Col(1))) & ' caracteres')
    END
    SQLM.WriteLog('SQLM es SQLMariaClass: servidor ' & SQLM.ServerVersion())
    SQLM.Kill()
  END
  SQLM.WriteLog('FIN')
[END]
[END]
[END]
